{
  "name": "code-audit-librarian",
  "displayName": "Code Audit Librarian",
  "description": "Vue.js Code Audit tool",
  "version": "1.0.0",
  "publisher": "admin",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "code-audit-librarian.open",
        "title": "Code Audit Librarian: Open"
      }
    ],
    "configuration": {
      "title": "Code Audit Librarian",
      "properties": {
        "code-audit-librarian.enginePath": {
          "type": "string",
          "default": "",
          "description": "Path to the cloned Code Audit Librarian project directory (containing audit_tool, report, etc.)"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/vscode": "^1.74.0",
    "@types/node": "16.x",
    "typescript": "^5.3.3"
  }
}
