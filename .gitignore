# =============================================================================
# Code Audit Librarian — Git Isolation Configuration
# =============================================================================

# IDE internal folders & temporary agent logs
.gemini/
.gemini
.vscode/
.idea/

# Python Virtual Environments & compiled files
venv/
.venv/
__pycache__/
*.pyc
*.pyo
*.pyd
.ipynb_checkpoints/

# Node.js dependencies and dynamic builds
node_modules/
dist/
report/frontend/dist/
report/frontend/public/graph.json

# VS Code Extension compilation & prebuilt binaries
out/
*.vsix
.vscode-test/

# SQLite databases & active WAL sidecars
# Every developer workspace clones and builds its own baseline sqlite configuration
*.db
*.db-journal
*.db-shm
*.db-wal

# Logging output
*.log
scan.log
eslint_report.json

# Environment files & secrets
.env
.env.*
! .env.example

# Zipped submission packages
*.zip